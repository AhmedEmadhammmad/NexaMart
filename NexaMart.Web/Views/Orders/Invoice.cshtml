@model NexaMart.Web.Models.OrderDetailsViewModel
@{
    ViewData["Title"] = $"Invoice #{Model.OrderNumber}";
}

<style>
    @@media print {
        header, footer, .navbar, .btn-actions-row, .alert, .breadcrumb {
            display: none !important;
        }
        .invoice-card {
            box-shadow: none !important;
            border: none !important;
            padding: 0 !important;
        }
        body {
            background: #ffffff !important;
        }
    }
</style>

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Orders" asp-action="Index" class="text-decoration-none">My Orders</a></li>
            <li class="breadcrumb-item active">Invoice #@Model.OrderNumber</li>
        </ol>
    </nav>

    <!-- Top Action Row -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 btn-actions-row">
        <div>
            <span class="badge bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-1">
                <i class="bi bi-check-circle-fill"></i> Order Complete
            </span>
            <h2 class="fw-bold mb-0">Official Tax Invoice</h2>
            <p class="text-muted small mb-0">Invoice Receipt & Verified Order Confirmation</p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-custom" onclick="window.print()">
                <i class="bi bi-printer"></i> Print Invoice
            </button>
            <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-custom">
                <i class="bi bi-clock-history"></i> My Orders
            </a>
            <a asp-controller="Products" asp-action="Index" class="btn btn-gradient">
                <i class="bi bi-bag"></i> Continue Shopping
            </a>
        </div>
    </div>

    <!-- The Printable Invoice Paper Card -->
    <div class="glass-card p-4 p-md-5 mb-4 invoice-card" style="background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); box-shadow: var(--shadow-md);">
        
        <!-- Invoice Header -->
        <div class="row g-4 align-items-center mb-5 pb-4 border-bottom">
            <!-- Company Logo & Details -->
            <div class="col-md-6">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="brand-logo-icon" style="width: 44px; height: 44px; border-radius: 12px; background: var(--gradient-primary); display: flex; align-items: center; justify-content: center; color: white;">
                        <i class="bi bi-bag-check-fill fs-4"></i>
                    </div>
                    <span class="fs-3 fw-bold">Nexa<span style="color: var(--primary);">Mart</span></span>
                </div>
                <div class="text-muted small" style="line-height: 1.6;">
                    <strong>NexaMart Global Retail Ltd.</strong><br />
                    123 Innovation Boulevard, Tech District<br />
                    Cairo, Egypt • Support: support@nexamart.com<br />
                    Tax Reg ID: <strong>EG-904-821-NXM</strong>
                </div>
            </div>

            <!-- Invoice Reference Info -->
            <div class="col-md-6 text-md-end">
                <span class="badge bg-primary px-3 py-2 text-uppercase fw-bold rounded-pill mb-2" style="letter-spacing: 1px;">
                    Tax Invoice / Receipt
                </span>
                <div class="display-6 fw-bold text-dark mb-1" style="font-size: 1.75rem;">
                    #@Model.OrderNumber
                </div>
                <div class="text-muted small mb-2">
                    Date Issued: <strong>@Model.OrderDate.ToString("MMMM dd, yyyy • hh:mm tt") UTC</strong>
                </div>
                <div>
                    <!-- Status badge -->
                    @{
                        string badgeClass = Model.Status switch
                        {
                            NexaMart.Domain.Enums.OrderStatus.Confirmed => "bg-primary-subtle text-primary border-primary",
                            NexaMart.Domain.Enums.OrderStatus.Processing => "bg-warning-subtle text-warning border-warning",
                            NexaMart.Domain.Enums.OrderStatus.Shipped => "bg-info-subtle text-info border-info",
                            NexaMart.Domain.Enums.OrderStatus.Delivered => "bg-success-subtle text-success border-success",
                            NexaMart.Domain.Enums.OrderStatus.Cancelled => "bg-danger-subtle text-danger border-danger",
                            _ => "bg-secondary-subtle text-secondary border-secondary"
                        };
                    }
                    <span class="badge @badgeClass border px-3 py-1 fw-bold rounded-pill">
                        Order Status: @Model.Status
                    </span>
                </div>
            </div>
        </div>

        <!-- Bill To / Ship To / Payment Information -->
        <div class="row g-4 mb-5">
            <div class="col-md-6">
                <h6 class="text-uppercase text-muted fw-bold small mb-2">Customer & Billing Details:</h6>
                <div class="p-3 rounded-3 border" style="background: #f8fafc;">
                    <div class="fw-bold fs-6 text-dark mb-1">@Model.UserName</div>
                    <div class="text-muted small mb-1"><i class="bi bi-envelope me-1"></i> @(string.IsNullOrEmpty(Model.UserEmail) ? "Verified Account Holder" : Model.UserEmail)</div>
                    @if (!string.IsNullOrEmpty(Model.UserPhone))
                    {
                        <div class="text-muted small mb-1"><i class="bi bi-telephone me-1"></i> @Model.UserPhone</div>
                    }
                    <div class="text-muted small"><i class="bi bi-person-badge me-1"></i> Customer ID: #@Model.UserId</div>
                </div>
            </div>

            <div class="col-md-6">
                <h6 class="text-uppercase text-muted fw-bold small mb-2">Delivery & Payment Information:</h6>
                <div class="p-3 rounded-3 border" style="background: #f8fafc;">
                    <div class="fw-bold text-dark mb-1"><i class="bi bi-truck me-1 text-primary"></i> Standard Expedited Courier</div>
                    <div class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i> @Model.ShippingAddress, @Model.City</div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top small">
                        <span class="text-muted">Payment Method:</span>
                        <span class="fw-bold text-dark"><i class="bi bi-credit-card-2-front me-1 text-success"></i> @Model.PaymentMethod</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-1 small">
                        <span class="text-muted">Payment Status:</span>
                        <span class="badge @(Model.PaymentStatus == NexaMart.Domain.Enums.PaymentStatus.Paid ? "bg-success" : "bg-warning text-dark")">@Model.PaymentStatus</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.TransactionId))
                    {
                        <div class="d-flex justify-content-between align-items-center pt-1 small">
                            <span class="text-muted">Paymob Ref:</span>
                            <span class="font-monospace text-dark">@Model.TransactionId</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Itemized Products Table -->
        <div class="mb-5">
            <h6 class="text-uppercase text-muted fw-bold small mb-3">Purchased Line Items:</h6>
            <div class="table-responsive">
                <table class="table align-middle border mb-0">
                    <thead class="table-light small text-muted text-uppercase">
                        <tr>
                            <th scope="col" class="ps-4 py-3">#</th>
                            <th scope="col" style="min-width: 250px;" class="py-3">Product Description</th>
                            <th scope="col" class="text-center py-3">Unit Price</th>
                            <th scope="col" class="text-center py-3">Quantity</th>
                            <th scope="col" class="text-end pe-4 py-3">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int itemIndex = 1;
                        }
                        @foreach (var lineItem in Model.OrderItems)
                        {
                            <tr>
                                <td class="ps-4 py-3 text-muted small">@itemIndex</td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-3 overflow-hidden border flex-shrink-0" style="width: 50px; height: 50px; background: #f8fafc;">
                                            <img src="@(lineItem.ProductImageUrl ?? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=120&auto=format&fit=crop&q=60")" 
                                                 alt="@lineItem.ProductName" 
                                                 style="width: 100%; height: 100%; object-fit: cover;">
                                        </div>
                                        <div>
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@lineItem.ProductId" class="fw-bold text-dark text-decoration-none d-block">
                                                @lineItem.ProductName
                                            </a>
                                            <span class="text-muted small">SKU: PROD-@lineItem.ProductId</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center py-3 text-dark fw-semibold">
                                    $@lineItem.UnitPrice.ToString("N2")
                                </td>
                                <td class="text-center py-3 fw-bold text-dark">
                                    @lineItem.Quantity
                                </td>
                                <td class="text-end pe-4 py-3 fw-bold text-primary">
                                    $@lineItem.TotalPrice.ToString("N2")
                                </td>
                            </tr>
                            itemIndex++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Financial Summary & Grand Total -->
        <div class="row g-4 justify-content-between align-items-start mb-5 pb-4 border-bottom">
            <!-- Left: Terms & Verified Seal -->
            <div class="col-md-6">
                <div class="p-3 rounded-3 border bg-light">
                    <h6 class="fw-bold mb-2 small text-dark"><i class="bi bi-shield-check text-success me-1"></i> Official Commercial Warranty</h6>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        All items listed in this invoice are backed by NexaMart's 14-day hassle-free return and replacement policy. For questions or refund inquiries, quote reference <strong>#@Model.OrderNumber</strong>.
                    </p>
                </div>
            </div>

            <!-- Right: Calculations Table -->
            <div class="col-md-5">
                <div class="d-flex flex-column gap-2 small">
                    <div class="d-flex justify-content-between text-muted">
                        <span>Items Subtotal (@Model.TotalItemsCount items):</span>
                        <span class="fw-bold text-dark">@Model.SubTotal.ToString("N2") @Model.Currency</span>
                    </div>
                    <div class="d-flex justify-content-between text-muted">
                        <span>Shipping & Freight:</span>
                        @if (Model.ShippingCost == 0)
                        {
                            <span class="fw-bold text-success">FREE Delivery (0.00 @Model.Currency)</span>
                        }
                        else
                        {
                            <span class="fw-bold text-dark">@Model.ShippingCost.ToString("N2") @Model.Currency</span>
                        }
                    </div>
                    @if (Model.TaxAmount > 0)
                    {
                        <div class="d-flex justify-content-between text-muted">
                            <span>Value Added Tax (VAT):</span>
                            <span class="fw-bold text-dark">@Model.TaxAmount.ToString("N2") @Model.Currency</span>
                        </div>
                    }
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between text-success">
                            <span>Promotional Discount:</span>
                            <span class="fw-bold">-@Model.DiscountAmount.ToString("N2") @Model.Currency</span>
                        </div>
                    }
                    <div class="border-top pt-2 mt-1 d-flex justify-content-between align-items-baseline">
                        <span class="fs-5 fw-bold text-dark">Total Payable:</span>
                        <span class="display-6 fw-bold text-primary" style="font-size: 2rem;">
                            @Model.TotalAmount.ToString("N2") @Model.Currency
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cancellation Notice / Reason (If Cancelled) -->
        @if (Model.Status == NexaMart.Domain.Enums.OrderStatus.Cancelled)
        {
            <div class="alert alert-danger border-0 rounded-3 p-3 mb-4">
                <h6 class="fw-bold mb-1"><i class="bi bi-x-circle-fill me-2"></i> This Order Was Cancelled</h6>
                <p class="small mb-0">Reason: <strong>@(Model.CancellationReason ?? "Customer cancelled request")</strong> • Date: @Model.CancelledAt?.ToString("MMM dd, yyyy")</p>
            </div>
        }
        else if (Model.Status == NexaMart.Domain.Enums.OrderStatus.Confirmed || Model.Status == NexaMart.Domain.Enums.OrderStatus.Processing)
        {
            <!-- Cancellation Action (CRUD) for Active Orders -->
            <div class="p-3 rounded-3 border bg-light d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 btn-actions-row">
                <div>
                    <h6 class="fw-bold mb-1 small text-dark">Need to cancel this order?</h6>
                    <p class="text-muted small mb-0">You can cancel your order before it gets dispatched to the delivery courier.</p>
                </div>

                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelOrderModal">
                    <i class="bi bi-x-circle"></i> Cancel Order
                </button>
            </div>

            <!-- Cancel Order Modal -->
            <div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content border-0 shadow-lg" style="border-radius: var(--radius-md);">
                        <div class="modal-header border-bottom">
                            <h5 class="modal-title fw-bold" id="cancelOrderModalLabel">Confirm Order Cancellation</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form asp-controller="Orders" asp-action="Cancel" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="modal-body">
                                <p class="text-muted small">Are you sure you want to cancel order <strong>#@Model.OrderNumber</strong>? Reserved items will be returned to store stock immediately.</p>
                                <div class="mb-3">
                                    <label class="form-label-custom small">Cancellation Reason</label>
                                    <select name="reason" class="form-select form-control-custom" required>
                                        <option value="Changed my mind">I changed my mind</option>
                                        <option value="Found better price elsewhere">Found better price elsewhere</option>
                                        <option value="Delivery time too long">Delivery time is too long</option>
                                        <option value="Ordered by mistake">Placed order by mistake</option>
                                        <option value="Other">Other reason</option>
                                    </select>
                                </div>
                            </div>
                            <div class="modal-footer border-top">
                                <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">Keep Order</button>
                                <button type="submit" class="btn btn-danger">Confirm Cancellation</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
