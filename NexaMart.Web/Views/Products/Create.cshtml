@model NexaMart.Web.Models.ProductFormViewModel
@{
    ViewData["Title"] = "Add New Product";
}

<div class="container" style="max-width: 750px;">
    <div class="mb-4">
        <a asp-action="Index" class="text-muted text-decoration-none small d-inline-flex align-items-center gap-1 mb-2">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
        <h2 class="fw-bold mb-1">Add New Product</h2>
        <p class="text-muted small">Enter product specifications, inventory, and category assignment</p>
    </div>

    <div class="glass-card p-4 p-md-5">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label-custom"></label>
                <input asp-for="Name" class="form-control form-control-custom" placeholder="e.g. Wireless Noise-Cancelling Headphones Pro" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label-custom"></label>
                    <select asp-for="CategoryId" asp-items="Model.CategoriesList" class="form-select form-control-custom">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Price" class="form-label-custom"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md);">$</span>
                        <input asp-for="Price" class="form-control form-control-custom border-start-0" type="number" step="0.01" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;" />
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="StockQuantity" class="form-label-custom"></label>
                    <input asp-for="StockQuantity" class="form-control form-control-custom" type="number" />
                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label-custom"></label>
                <input asp-for="ImageUrl" class="form-control form-control-custom" placeholder="https://images.unsplash.com/..." />
                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label-custom"></label>
                <textarea asp-for="Description" class="form-control form-control-custom" rows="4" placeholder="Detailed product specifications, key features, and compatibility..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <div class="form-check form-switch p-3 border rounded-3" style="background: var(--light-bg);">
                    <input asp-for="IsActive" class="form-check-input ms-0 me-2" role="switch" id="isActiveSwitch">
                    <label class="form-check-label fw-semibold small" for="isActiveSwitch">Active & Visible in Catalog</label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-gradient flex-grow-1">
                    <i class="bi bi-check-circle"></i> Save Product
                </button>
                <a asp-action="Index" class="btn btn-outline-custom">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
