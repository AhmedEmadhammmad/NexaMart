@model NexaMart.Web.Models.CategoryFormViewModel
@{
    var isEdit = Model.Id.HasValue && Model.Id.Value > 0;
    ViewData["Title"] = isEdit ? $"Edit Category #{Model.Id}" : "Create New Category";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center mb-5">
    <div class="col-12 col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold mb-0">
                    <i class="bi @(isEdit ? "bi-pencil-square" : "bi-folder-plus") text-info me-2"></i>
                    @(isEdit ? $"Edit Category #{Model.Id}" : "Create New Category")
                </h3>
                <p class="text-muted small mb-0">Configure store catalog department, display ranking, and banner artwork.</p>
            </div>
            <a asp-action="Categories" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Categories Table
            </a>
        </div>

        <div class="admin-card p-4 bg-white shadow-sm">
            <form asp-action="@(isEdit ? "EditCategory" : "CreateCategory")" asp-route-id="@(isEdit ? Model.Id : null)" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                <div class="row g-3">
                    <!-- Name -->
                    <div class="col-12">
                        <label asp-for="Name" class="form-label small fw-bold text-dark"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Gaming & VR Accessories" autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Display Order & Active -->
                    <div class="col-12 col-md-6">
                        <label asp-for="DisplayOrder" class="form-label small fw-bold text-dark"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" placeholder="0" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6 d-flex align-items-center">
                        <div class="form-check mt-3">
                            <input asp-for="IsActive" class="form-check-input" id="isActiveCheck" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold text-dark" for="isActiveCheck">
                                Active in Navigation
                            </label>
                        </div>
                    </div>

                    <!-- Image URL -->
                    <div class="col-12">
                        <label asp-for="ImageUrl" class="form-label small fw-bold text-dark"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-image"></i></span>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." />
                        </div>
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label small fw-bold text-dark"></label>
                        <textarea asp-for="Description" rows="3" class="form-control" placeholder="Brief summary of items within this department..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Categories" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-info text-white px-4">
                        <i class="bi bi-check2-circle me-1"></i> @(isEdit ? "Save Changes" : "Create Category")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
