@model NexaMart.Web.Models.CategoryFormViewModel
@{
    var isEdit = Model.Id.HasValue && Model.Id.Value > 0;
    ViewData["Title"] = isEdit ? $"Edit Category #{Model.Id}" : "Create New Category";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center mb-5">
    <div class="col-12 col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold mb-0">
                    <i class="bi @(isEdit ? "bi-pencil-square" : "bi-folder-plus") text-info me-2"></i>
                    @(isEdit ? $"Edit Category #{Model.Id}" : "Create New Category")
                </h3>
                <p class="text-muted small mb-0">Configure store catalog department, display ranking, and banner artwork.</p>
            </div>
            <a asp-action="Categories" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Categories Table
            </a>
        </div>

        <div class="admin-card p-4 bg-white shadow-sm">
            <form asp-action="@(isEdit ? "EditCategory" : "CreateCategory")" asp-route-id="@(isEdit ? Model.Id : null)" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                <div class="row g-3">
                    <!-- Name -->
                    <div class="col-12">
                        <label asp-for="Name" class="form-label small fw-bold text-dark"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Gaming & VR Accessories" autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Display Order & Active -->
                    <div class="col-12 col-md-6">
                        <label asp-for="DisplayOrder" class="form-label small fw-bold text-dark"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" placeholder="0" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6 d-flex align-items-center">
                        <div class="form-check mt-3">
                            <input asp-for="IsActive" class="form-check-input" id="isActiveCheck" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold text-dark" for="isActiveCheck">
                                Active in Navigation
                            </label>
                        </div>
                    </div>

                    <!-- Category Banner / Icon Image Drag & Drop Area -->
                    <div class="col-12">
                        <label class="form-label small fw-bold text-dark">Category Image</label>
                        <div id="categoryDropZone" class="border border-2 border-dashed rounded-3 p-4 text-center bg-light position-relative" style="transition: all 0.2s ease; cursor: pointer;">
                            <input type="file" asp-for="ImageFile" id="categoryImageInput" class="d-none" accept=".jpg,.jpeg,.png,.webp" />
                            
                            <!-- Prompt State -->
                            <div id="categoryDropPrompt" class="@(string.IsNullOrEmpty(Model.ImageUrl) ? "" : "d-none") py-3">
                                <i class="bi bi-cloud-arrow-up text-info display-5 d-block mb-2"></i>
                                <h6 class="fw-bold mb-1">Drag &amp; drop category banner/icon here, or <span class="text-info text-decoration-underline" id="categoryBrowseLink">Browse</span></h6>
                                <p class="text-muted small mb-0">Supported formats: JPG, PNG, WebP (Max size: 5 MB)</p>
                            </div>

                            <!-- Preview State -->
                            <div id="categoryPreviewContainer" class="@(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "") position-relative d-inline-block text-center">
                                <img id="categoryImagePreview" src="@(Model.ImageUrl ?? "")" alt="Category Image Preview" class="img-thumbnail rounded-3 shadow-sm" style="max-height: 200px; max-width: 100%; object-fit: contain;" />
                                <div class="mt-2">
                                    <button type="button" id="changeCategoryImageBtn" class="btn btn-outline-info btn-sm me-1">
                                        <i class="bi bi-arrow-repeat"></i> Change Image
                                    </button>
                                    <button type="button" id="removeCategoryImageBtn" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" asp-for="ImageUrl" id="categoryExistingImageUrl" />
                        <span asp-validation-for="ImageFile" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label small fw-bold text-dark"></label>
                        <textarea asp-for="Description" rows="3" class="form-control" placeholder="Brief summary of items within this department..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Categories" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-info text-white px-4">
                        <i class="bi bi-check2-circle me-1"></i> @(isEdit ? "Save Changes" : "Create Category")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const dropZone = document.getElementById("categoryDropZone");
            const fileInput = document.getElementById("categoryImageInput");
            const browseLink = document.getElementById("categoryBrowseLink");
            const dropPrompt = document.getElementById("categoryDropPrompt");
            const previewContainer = document.getElementById("categoryPreviewContainer");
            const imagePreview = document.getElementById("categoryImagePreview");
            const removeBtn = document.getElementById("removeCategoryImageBtn");
            const changeBtn = document.getElementById("changeCategoryImageBtn");
            const existingUrlInput = document.getElementById("categoryExistingImageUrl");

            function triggerBrowse(e) {
                if (e) e.stopPropagation();
                fileInput.click();
            }

            if (browseLink) browseLink.addEventListener("click", triggerBrowse);
            if (changeBtn) changeBtn.addEventListener("click", triggerBrowse);

            dropZone.addEventListener("click", function (e) {
                if (e.target !== removeBtn && e.target !== changeBtn && !removeBtn.contains(e.target)) {
                    if (previewContainer.classList.contains("d-none")) {
                        triggerBrowse();
                    }
                }
            });

            // Drag and Drop highlights
            ['dragenter', 'dragover'].forEach(eventName => {
                dropZone.addEventListener(eventName, function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.classList.add("border-info", "bg-white", "shadow-sm");
                });
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.classList.remove("border-info", "bg-white", "shadow-sm");
                });
            });

            dropZone.addEventListener("drop", function (e) {
                const files = e.dataTransfer.files;
                if (files && files.length > 0) {
                    validateAndApplyFile(files[0]);
                }
            });

            fileInput.addEventListener("change", function (e) {
                if (e.target.files && e.target.files.length > 0) {
                    validateAndApplyFile(e.target.files[0]);
                }
            });

            function validateAndApplyFile(file) {
                const allowedExtensions = ['.jpg', '.jpeg', '.png', '.webp'];
                const fileName = file.name.toLowerCase();
                const hasValidExtension = allowedExtensions.some(ext => fileName.endsWith(ext));

                if (!hasValidExtension) {
                    alert("Invalid file type. Only JPG, PNG, and WebP images are permitted.");
                    fileInput.value = "";
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    alert("Image size exceeds the maximum limit of 5 MB.");
                    fileInput.value = "";
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (event) {
                    imagePreview.src = event.target.result;
                    previewContainer.classList.remove("d-none");
                    dropPrompt.classList.add("d-none");
                };
                reader.readAsDataURL(file);
            }

            removeBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                fileInput.value = "";
                imagePreview.src = "";
                existingUrlInput.value = "";
                previewContainer.classList.add("d-none");
                dropPrompt.classList.remove("d-none");
            });
        });
    </script>
}
