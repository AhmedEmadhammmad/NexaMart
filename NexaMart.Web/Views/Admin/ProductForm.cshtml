@model NexaMart.Web.Models.ProductFormViewModel
@{
    var isEdit = Model.Id.HasValue && Model.Id.Value > 0;
    ViewData["Title"] = isEdit ? $"Edit Product #{Model.Id}" : "Create New Product";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center mb-5">
    <div class="col-12 col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold mb-0">
                    <i class="bi @(isEdit ? "bi-pencil-square" : "bi-plus-circle") text-primary me-2"></i>
                    @(isEdit ? $"Edit Product #{Model.Id}" : "Create New Product")
                </h3>
                <p class="text-muted small mb-0">Configure product specifications, pricing, inventory stock, and categorization.</p>
            </div>
            <a asp-action="Products" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Products Table
            </a>
        </div>

        <div class="admin-card p-4 bg-white shadow-sm">
            <form asp-action="@(isEdit ? "EditProduct" : "CreateProduct")" asp-route-id="@(isEdit ? Model.Id : null)" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                <div class="row g-3">
                    <!-- Product Name -->
                    <div class="col-12">
                        <label asp-for="Name" class="form-label small fw-bold text-dark"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Ultra Pro Smartphone Model-101" autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Category & Price -->
                    <div class="col-12 col-md-6">
                        <label asp-for="CategoryId" class="form-label small fw-bold text-dark"></label>
                        <select asp-for="CategoryId" asp-items="Model.CategoriesList" class="form-select">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Price" class="form-label small fw-bold text-dark"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <!-- Stock Quantity & Status -->
                    <div class="col-12 col-md-6">
                        <label asp-for="StockQuantity" class="form-label small fw-bold text-dark"></label>
                        <input asp-for="StockQuantity" class="form-control" type="number" min="0" placeholder="Available units in warehouse" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6 d-flex align-items-center">
                        <div class="form-check mt-3">
                            <input asp-for="IsActive" class="form-check-input" id="isActiveCheck" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold text-dark" for="isActiveCheck">
                                Visible and Active in Storefront
                            </label>
                        </div>
                    </div>

                    <!-- Image URL -->
                    <div class="col-12">
                        <label asp-for="ImageUrl" class="form-label small fw-bold text-dark"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-image"></i></span>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." />
                        </div>
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label small fw-bold text-dark"></label>
                        <textarea asp-for="Description" rows="4" class="form-control" placeholder="Detailed product specifications, warranty, features..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Products" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check2-circle me-1"></i> @(isEdit ? "Save Changes" : "Create Product")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
