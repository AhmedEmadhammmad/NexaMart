@model NexaMart.Web.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Store Admin Command Hub";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <!-- Top Header & Search Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-grid-1x2-fill text-primary"></i> Store Admin Dashboard
            </h2>
            <p class="text-muted mb-0 small">
                Complete catalog governance, tabular product & category management, real-time inventory metrics.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="CreateProduct" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-plus-circle"></i> Add New Product
            </a>
            <a asp-action="CreateCategory" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <i class="bi bi-folder-plus"></i> Add Category
            </a>
        </div>
    </div>

    <!-- Quick Universal Search by Numeric ID -->
    <div class="admin-card p-3 mb-4 border-primary border-opacity-25 bg-white shadow-sm">
        <form asp-action="SearchById" method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <span class="badge bg-primary px-2 py-1"><i class="bi bi-search me-1"></i> Quick ID Lookup</span>
            </div>
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-hash"></i></span>
                    <input type="number" name="id" class="form-control" placeholder="Enter Product, Category, or Order ID (e.g. 5)" required min="1" />
                </div>
            </div>
            <div class="col-12 col-md-3">
                <select name="type" class="form-select">
                    <option value="All">All Entity Types (Auto-detect)</option>
                    <option value="Product">Product ID</option>
                    <option value="Category">Category ID</option>
                    <option value="Order">Order ID</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-dark d-flex align-items-center gap-1">
                    <i class="bi bi-arrow-right-circle"></i> Search & Open
                </button>
            </div>
        </form>
    </div>

    <!-- KPI Metric Cards Grid -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="admin-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">TOTAL PRODUCTS</span>
                    <div class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-box-seam fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1">@Model.TotalProducts</h3>
                <div class="small text-muted d-flex align-items-center gap-2">
                    <span class="badge bg-success bg-opacity-10 text-success">@Model.ActiveProductsCount Active</span>
                    <span class="badge bg-warning bg-opacity-10 text-warning">@Model.LowStockProductsCount Low Stock</span>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="admin-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">TOTAL CATEGORIES</span>
                    <div class="p-2 rounded-3 bg-info bg-opacity-10 text-info">
                        <i class="bi bi-tags fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1">@Model.TotalCategories</h3>
                <div class="small text-muted">
                    <a asp-action="Categories" class="text-decoration-none text-info small fw-semibold">
                        View All Categories &rarr;
                    </a>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="admin-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">OVERALL PRODUCT RATING</span>
                    <div class="p-2 rounded-3 bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-star-fill fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1 text-warning">
                    @Model.OverallAverageRating.ToString("F1") <span class="fs-6 text-muted">/ 5.0</span>
                </h3>
                <div class="small text-muted">
                    <span>@Model.TotalReviewsCount verified customer reviews (Zeroed-out)</span>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="admin-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">STORE ORDERS & REVENUE</span>
                    <div class="p-2 rounded-3 bg-success bg-opacity-10 text-success">
                        <i class="bi bi-currency-dollar fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1">@Model.TotalRevenue.ToString("C")</h3>
                <div class="small text-muted">
                    <span>@Model.TotalOrders total orders recorded</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Hub Strip -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-action="Products" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-table"></i> Open Full Products Data Table
        </a>
        <a asp-action="Categories" class="btn btn-outline-info btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-tags"></i> Open Categories Data Table
        </a>
        <a asp-action="Orders" class="btn btn-outline-success btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-receipt"></i> Open Orders Management Table
        </a>
    </div>

    <!-- 1. RECENTLY ADDED PRODUCTS (STRICTLY IN A CLEAN TABLE, NOT CARDS) -->
    <div class="admin-table-container mb-4">
        <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-box-seam-fill text-primary"></i> Recently Added Products
                </h5>
                <small class="text-muted">Displaying latest catalog additions in data table view (No card view).</small>
            </div>
            <a asp-action="Products" class="btn btn-sm btn-primary">
                View All (@Model.TotalProducts)
            </a>
        </div>

        <div class="table-responsive">
            <table class="table admin-table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th style="width: 70px;">Image</th>
                        <th>Product Details</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Avg Rating</th>
                        <th>Status</th>
                        <th>Added Date</th>
                        <th class="text-end" style="width: 170px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentProducts != null && Model.RecentProducts.Any())
                    {
                        @foreach (var p in Model.RecentProducts)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary font-monospace">#@p.Id</span>
                                </td>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://placehold.co/80x80?text=No+Img" : p.ImageUrl)" 
                                         alt="@p.Name" 
                                         class="rounded-2 border" 
                                         style="width: 48px; height: 48px; object-fit: cover;" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 250px;">@p.Name</div>
                                    <small class="text-muted">ID: @p.Id</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@p.CategoryName</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-primary">@p.Price.ToString("C")</span>
                                </td>
                                <td>
                                    @if (p.StockQuantity <= 0)
                                    {
                                        <span class="badge bg-danger">Out of Stock (0)</span>
                                    }
                                    else if (p.StockQuantity < 10)
                                    {
                                        <span class="badge bg-warning text-dark">Low (@p.StockQuantity)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success fw-semibold">@p.StockQuantity in stock</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <i class="bi bi-star-fill text-warning" style="font-size: 0.85rem;"></i>
                                        <span class="fw-bold">@p.AverageRating.ToString("F1")</span>
                                        <small class="text-muted">(@p.ReviewCount)</small>
                                    </div>
                                </td>
                                <td>
                                    @if (p.IsActive)
                                    {
                                        <span class="badge badge-status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-status-blocked">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@p.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="EditProduct" asp-route-id="@p.Id" class="btn btn-outline-secondary" title="Edit Product">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="ToggleProductStatus" asp-route-id="@p.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(p.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(p.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(p.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </form>
                                        <form asp-action="DeleteProduct" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete product #@p.Id?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete Product">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i> No products found in the catalog.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 2. CATEGORIES BREAKDOWN & AVERAGE RATINGS TABLE -->
    <div class="admin-table-container mb-4">
        <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-tags-fill text-info"></i> Category Overview & Average Ratings
                </h5>
                <small class="text-muted">Breakdown of all categories, product counts, and per-category average ratings.</small>
            </div>
            <a asp-action="Categories" class="btn btn-sm btn-info text-white">
                Manage Categories (@Model.TotalCategories)
            </a>
        </div>

        <div class="table-responsive">
            <table class="table admin-table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th style="width: 70px;">Cover</th>
                        <th>Category Name</th>
                        <th>Display Order</th>
                        <th>Products Count</th>
                        <th>Category Avg Rating</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 170px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.CategoryStats != null && Model.CategoryStats.Any())
                    {
                        @foreach (var cat in Model.CategoryStats)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary font-monospace">#@cat.Id</span>
                                </td>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(cat.ImageUrl) ? "https://placehold.co/80x80?text=Category" : cat.ImageUrl)" 
                                         alt="@cat.Name" 
                                         class="rounded-2 border" 
                                         style="width: 44px; height: 44px; object-fit: cover;" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@cat.Name</div>
                                    <small class="text-muted text-truncate d-block" style="max-width: 250px;">@cat.Description</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border">Order: @cat.DisplayOrder</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1">
                                        @cat.ProductCount Products
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <i class="bi bi-star-fill text-warning" style="font-size: 0.85rem;"></i>
                                        <span class="fw-bold">@cat.AverageRating.ToString("F1")</span>
                                        <small class="text-muted">/ 5.0</small>
                                    </div>
                                </td>
                                <td>
                                    @if (cat.IsActive)
                                    {
                                        <span class="badge badge-status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-status-blocked">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Products" asp-route-CategoryId="@cat.Id" class="btn btn-outline-primary" title="Filter Products in Category">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="EditCategory" asp-route-id="@cat.Id" class="btn btn-outline-secondary" title="Edit Category">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="ToggleCategoryStatus" asp-route-id="@cat.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(cat.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(cat.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(cat.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-folder-x fs-3 d-block mb-1"></i> No categories configured yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 3. RECENT STORE ORDERS TABLE -->
    <div class="admin-table-container">
        <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-receipt text-success"></i> Recent Orders & Invoices
                </h5>
                <small class="text-muted">Real-time order flow and customer transactions.</small>
            </div>
            <a asp-action="Orders" class="btn btn-sm btn-success">
                Manage All Orders (@Model.TotalOrders)
            </a>
        </div>

        <div class="table-responsive">
            <table class="table admin-table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th>Order Date</th>
                        <th class="text-end">Tax Invoice</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                    {
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-dark font-monospace">@order.OrderNumber</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@order.CustomerName</div>
                                    <small class="text-muted">@order.CustomerEmail</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border">@order.ItemsCount Items</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-success">@order.TotalAmount.ToString("C")</span>
                                </td>
                                <td>
                                    <span class="badge @(order.Status == NexaMart.Domain.Enums.OrderStatus.Delivered ? "bg-success" : order.Status == NexaMart.Domain.Enums.OrderStatus.Cancelled ? "bg-danger" : "bg-primary")">
                                        @order.Status
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</small>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Orders" asp-action="Invoice" asp-route-id="@order.Id" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-printer me-1"></i> View Invoice
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-receipt fs-3 d-block mb-1"></i> No orders recorded yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
