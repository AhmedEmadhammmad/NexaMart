@model NexaMart.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Discover Premium Products";
}

<div class="container">
    <!-- Hero Banner -->
    <div class="hero-banner">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill mb-3">
                    <i class="bi bi-stars"></i> Next-Generation Shopping Experience
                </span>
                <h1 class="hero-title mb-3">
                    Shop Smarter, Live Better with <span class="hero-highlight">NexaMart</span>
                </h1>
                <p class="text-muted fs-5 mb-4" style="max-width: 540px;">
                    Explore curated selections of top-tier electronics, fashion, and home accessories backed by verified customer ratings and lightning-fast delivery.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-gradient btn-lg">
                        <i class="bi bi-bag"></i> Browse Products
                    </a>
                    <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-custom btn-lg">
                        <i class="bi bi-tags"></i> Explore Categories
                    </a>
                </div>

                <!-- Trust Metrics -->
                <div class="row g-3 mt-4 pt-2 border-top">
                    <div class="col-4">
                        <div class="fw-bold fs-4 text-dark">500+</div>
                        <div class="text-muted small">Quality Products</div>
                    </div>
                    <div class="col-4">
                        <div class="fw-bold fs-4 text-dark">20+</div>
                        <div class="text-muted small">Curated Categories</div>
                    </div>
                    <div class="col-4">
                        <div class="fw-bold fs-4 text-dark">99.8%</div>
                        <div class="text-muted small">Satisfaction Rate</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5 text-center d-none d-lg-block">
                <div class="position-relative">
                    <div style="width: 320px; height: 320px; background: var(--gradient-primary); border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; opacity: 0.2; filter: blur(40px); position: absolute; top: 0; right: 0;"></div>
                    <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80" 
                         alt="Hero Product Showcase" 
                         class="img-fluid rounded-4 shadow-lg position-relative" 
                         style="max-height: 380px; object-fit: cover; border: 4px solid white;">
                </div>
            </div>
        </div>
    </div>

    <!-- Features Bar -->
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="glass-card p-3 p-lg-4 d-flex align-items-center gap-3">
                <div class="brand-logo-icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981; min-width: 48px; height: 48px;">
                    <i class="bi bi-truck fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Express Fast Shipping</h6>
                    <p class="text-muted small mb-0">Free doorstep delivery on all orders over $100.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card p-3 p-lg-4 d-flex align-items-center gap-3">
                <div class="brand-logo-icon" style="background: rgba(99, 102, 241, 0.15); color: var(--primary); min-width: 48px; height: 48px;">
                    <i class="bi bi-shield-check fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Verified Authenticity</h6>
                    <p class="text-muted small mb-0">100% genuine guaranteed with 30-day returns.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card p-3 p-lg-4 d-flex align-items-center gap-3">
                <div class="brand-logo-icon" style="background: rgba(6, 182, 212, 0.15); color: var(--secondary); min-width: 48px; height: 48px;">
                    <i class="bi bi-headset fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">24/7 Priority Support</h6>
                    <p class="text-muted small mb-0">Direct customer service anytime you need.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Featured Categories Section -->
    @if (Model.FeaturedCategories.Any())
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <span class="text-uppercase text-primary fw-bold small tracking-wider">Explore</span>
                    <h3 class="fw-bold mb-0">Popular Categories</h3>
                </div>
                <a asp-controller="Categories" asp-action="Index" class="text-primary text-decoration-none fw-semibold">
                    View All Categories <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3">
                @foreach (var category in Model.FeaturedCategories)
                {
                    <div class="col">
                        <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="@category.Id" class="category-card">
                            <div class="category-icon-wrapper">
                                @if (!string.IsNullOrEmpty(category.ImageUrl))
                                {
                                    <img src="@category.ImageUrl" alt="@category.Name" style="width: 100%; height: 100%; object-fit: cover;">
                                }
                                else
                                {
                                    <i class="bi bi-grid-fill fs-3"></i>
                                }
                            </div>
                            <h6 class="fw-bold mb-1 text-truncate w-100">@category.Name</h6>
                            <span class="text-muted small">@category.ProductCount items</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Top Selling Products Section -->
    @if (Model.TopSellingProducts.Any())
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <span class="text-uppercase text-danger fw-bold small tracking-wider">Top Rated</span>
                    <h3 class="fw-bold mb-0">Best Selling Products</h3>
                </div>
                <a asp-controller="Products" asp-action="Index" asp-route-SortBy="top_selling" class="text-primary text-decoration-none fw-semibold">
                    See All Best Sellers <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @foreach (var product in Model.TopSellingProducts)
                {
                    <div class="col">
                        <div class="product-card">
                            <div class="product-img-wrapper">
                                <span class="badge-stock @(product.InStock ? "badge-in-stock" : "badge-out-stock")">
                                    @(product.InStock ? "In Stock" : "Out of Stock")
                                </span>
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                                    <img src="@(product.ImageUrl ?? "https://images.unsplash.com/photo-1560343090-f0409e92791a?w=500&auto=format&fit=crop&q=60")" 
                                         alt="@product.Name" 
                                         loading="lazy">
                                </a>
                            </div>

                            <div class="p-3 d-flex flex-column flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge-category">@product.CategoryName</span>
                                    <div class="star-rating">
                                        <i class="bi bi-star-fill"></i>
                                        <span class="fw-bold text-dark">@product.AverageRating.ToString("F1")</span>
                                        <span class="text-muted small">(@product.ReviewCount)</span>
                                    </div>
                                </div>

                                <h6 class="fw-bold mb-2">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="text-dark text-decoration-none text-truncate d-block">
                                        @product.Name
                                    </a>
                                </h6>

                                <div class="mt-auto pt-2 d-flex justify-content-between align-items-center">
                                    <span class="product-price">$@product.Price.ToString("N2")</span>
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-gradient">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Latest Arrivals Section -->
    @if (Model.LatestProducts.Any())
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <span class="text-uppercase text-secondary fw-bold small tracking-wider">Fresh In Store</span>
                    <h3 class="fw-bold mb-0">Latest Arrivals</h3>
                </div>
                <a asp-controller="Products" asp-action="Index" asp-route-SortBy="newest" class="text-primary text-decoration-none fw-semibold">
                    Explore New Items <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @foreach (var product in Model.LatestProducts)
                {
                    <div class="col">
                        <div class="product-card">
                            <div class="product-img-wrapper">
                                <span class="badge-stock @(product.InStock ? "badge-in-stock" : "badge-out-stock")">
                                    @(product.InStock ? "In Stock" : "Out of Stock")
                                </span>
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                                    <img src="@(product.ImageUrl ?? "https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=500&auto=format&fit=crop&q=60")" 
                                         alt="@product.Name" 
                                         loading="lazy">
                                </a>
                            </div>

                            <div class="p-3 d-flex flex-column flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge-category">@product.CategoryName</span>
                                    <div class="star-rating">
                                        <i class="bi bi-star-fill"></i>
                                        <span class="fw-bold text-dark">@product.AverageRating.ToString("F1")</span>
                                        <span class="text-muted small">(@product.ReviewCount)</span>
                                    </div>
                                </div>

                                <h6 class="fw-bold mb-2">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="text-dark text-decoration-none text-truncate d-block">
                                        @product.Name
                                    </a>
                                </h6>

                                <div class="mt-auto pt-2 d-flex justify-content-between align-items-center">
                                    <span class="product-price">$@product.Price.ToString("N2")</span>
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-custom">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Contact Us & Customer Complaints Section -->
    <div class="mb-5 pt-3" id="contactSection">
        <div class="glass-card p-4 p-lg-5" style="border-top: 4px solid var(--primary);">
            <div class="row g-5">
                <!-- Left: Contact Details & Guarantee -->
                <div class="col-lg-4">
                    <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill mb-2">
                        <i class="bi bi-headset"></i> Customer Service
                    </span>
                    <h3 class="fw-bold mb-3">Contact Us & Support</h3>
                    <p class="text-muted small mb-4" style="line-height: 1.7;">
                        Have questions about products, facing delivery issues, or need to lodge a formal complaint? We are dedicated to providing swift resolutions.
                    </p>

                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background: rgba(99, 102, 241, 0.05); border: 1px solid rgba(99, 102, 241, 0.1);">
                            <div class="text-primary fs-4"><i class="bi bi-telephone-fill"></i></div>
                            <div>
                                <div class="text-muted small">Support Hotline</div>
                                <div class="fw-bold text-dark">+1 (800) 555-NEXA</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background: rgba(6, 182, 212, 0.05); border: 1px solid rgba(6, 182, 212, 0.1);">
                            <div class="text-info fs-4"><i class="bi bi-envelope-fill"></i></div>
                            <div>
                                <div class="text-muted small">Complaints Desk</div>
                                <div class="fw-bold text-dark">complaints@nexamart.com</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.1);">
                            <div class="text-success fs-4"><i class="bi bi-clock-history"></i></div>
                            <div>
                                <div class="text-muted small">Response Guarantee</div>
                                <div class="fw-bold text-dark">Within 24 Business Hours</div>
                            </div>
                        </div>
                    </div>

                    <a asp-controller="Home" asp-action="ContactUs" class="btn btn-outline-custom w-100">
                        <i class="bi bi-arrow-up-right-square"></i> Dedicated Support Portal
                    </a>
                </div>

                <!-- Right: Complaints & Feedback Form -->
                <div class="col-lg-8">
                    <div class="p-4 rounded-4" style="background: #ffffff; border: 1px solid var(--border-color);">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="fw-bold mb-0">File a Complaint or Feedback</h4>
                            <span class="badge bg-warning-subtle text-warning fw-bold px-2 py-1 rounded-pill small">
                                <i class="bi bi-shield-exclamation"></i> Customer Ticket
                            </span>
                        </div>
                        <p class="text-muted small mb-4">Submit your issue directly to our customer operations team for immediate investigation.</p>

                        <form asp-controller="Home" asp-action="SubmitComplaint" method="post">
                            @Html.AntiForgeryToken()

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label-custom small">Full Name <span class="text-danger">*</span></label>
                                    <input type="text" name="FullName" class="form-control form-control-custom" placeholder="Your Name" required maxlength="100" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-custom small">Email Address <span class="text-danger">*</span></label>
                                    <input type="email" name="Email" class="form-control form-control-custom" placeholder="name@domain.com" required />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label-custom small">Phone Number</label>
                                    <input type="tel" name="PhoneNumber" class="form-control form-control-custom" placeholder="+1 (555) 000-0000" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label-custom small">Complaint / Inquiry Type <span class="text-danger">*</span></label>
                                    <select name="InquiryType" class="form-select form-control-custom" required>
                                        <option value="1">💬 General Inquiry</option>
                                        <option value="2">🚚 Order Delivery Delay</option>
                                        <option value="3">📦 Damaged / Defective Product</option>
                                        <option value="4">💳 Payment / Refund Issue</option>
                                        <option value="5">⚠️ Service Complaint / Escalation</option>
                                        <option value="6">📌 Other</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label-custom small">Order Number (Optional)</label>
                                    <input type="text" name="OrderNumber" class="form-control form-control-custom" placeholder="e.g. ORD-2026-XXXX" maxlength="50" />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-8">
                                    <label class="form-label-custom small">Subject <span class="text-danger">*</span></label>
                                    <input type="text" name="Subject" class="form-control form-control-custom" placeholder="Summary of the issue" required maxlength="150" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label-custom small">Priority</label>
                                    <select name="Priority" class="form-select form-control-custom">
                                        <option value="1">🟢 Normal Priority</option>
                                        <option value="2">🟡 High Priority</option>
                                        <option value="3">🔴 Urgent</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label-custom small">Complaint Details / Description <span class="text-danger">*</span></label>
                                <textarea name="Message" rows="4" class="form-control form-control-custom" placeholder="Please provide specific details regarding your issue or order..." required maxlength="3000"></textarea>
                            </div>

                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-gradient px-4 py-2">
                                    <i class="bi bi-send-check"></i> Submit Ticket
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
