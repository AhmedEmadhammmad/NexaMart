                    <div class="stat-item">
                        <h4>500<span>+</span></h4>
                        <p>Verified Vendors</p>
                    </div>
                    <div class="stat-item">
                        <h4>15k<span>+</span></h4>
                        <p>Active Products</p>
                    </div>
                    <div class="stat-item">
                        <h4>99.8<span>%</span></h4>
                        <p>Satisfied Customers</p>
                    </div>
                    <div class="stat-item">
                        <h4>24<span>/7</span></h4>
                        <p>Real-Time Support</p>
                    </div>
                </div>
            </div>

            <!-- Hero Feature Graphic Card -->
            <div class="col-lg-5">
                <div class="glass-card p-4 position-relative">
                    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom border-secondary pb-3">
