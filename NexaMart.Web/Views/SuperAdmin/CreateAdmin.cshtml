@model NexaMart.Web.Models.CreateAdminAccountViewModel
@{
    ViewData["Title"] = "Provision Administrator Account";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center mb-5">
    <div class="col-12 col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold mb-0">
                    <i class="bi bi-person-plus-fill text-primary me-2"></i> Provision Admin Account
                </h3>
                <p class="text-muted small mb-0">Grant administrative or executive authority to a staff member.</p>
            </div>
            <a asp-action="Users" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Accounts Table
            </a>
        </div>

        <div class="admin-card p-4 bg-white shadow-sm">
            <form asp-action="CreateAdmin" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                <div class="row g-3">
                    <!-- Full Name -->
                    <div class="col-12">
                        <label asp-for="FullName" class="form-label small fw-bold text-dark"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Staff Member Name" autofocus />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <!-- Email -->
                    <div class="col-12">
                        <label asp-for="Email" class="form-label small fw-bold text-dark"></label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="staff.name@nexamart.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Phone Number -->
                    <div class="col-12">
                        <label asp-for="PhoneNumber" class="form-label small fw-bold text-dark"></label>
                        <input asp-for="PhoneNumber" class="form-control" type="tel" placeholder="+20 100 000 0000" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <!-- Role Type -->
                    <div class="col-12">
                        <label asp-for="RoleType" class="form-label small fw-bold text-dark"></label>
                        <select asp-for="RoleType" class="form-select">
                            <option value="@NexaMart.Domain.Enums.UserRoleType.Admin">Store Administrator (Catalog, Products, Orders)</option>
                            <option value="@NexaMart.Domain.Enums.UserRoleType.SuperAdmin">Super Administrator (Global Site Authority & Users)</option>
                        </select>
                        <span asp-validation-for="RoleType" class="text-danger small"></span>
                    </div>

                    <!-- Password -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Password" class="form-label small fw-bold text-dark"></label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="col-12 col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label small fw-bold text-dark"></label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Users" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-shield-check me-1"></i> Provision Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
