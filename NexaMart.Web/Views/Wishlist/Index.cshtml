@model NexaMart.Web.Models.WishlistViewModel
@{
    ViewData["Title"] = "My Saved Wishlist";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index" class="text-decoration-none">Products</a></li>
            <li class="breadcrumb-item active">Wishlist</li>
        </ol>
    </nav>

    <!-- Header & Action Row -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge bg-danger-subtle text-danger fw-bold px-3 py-1 rounded-pill mb-1">
                <i class="bi bi-heart-fill"></i> Favorites
            </span>
            <h2 class="fw-bold mb-0">My Wishlist</h2>
            <p class="text-muted small mb-0">Manage products you have saved for future purchases</p>
        </div>

        @if (!Model.IsEmpty)
        {
            <div class="d-flex gap-2 align-items-center">
                <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill fw-semibold">
                    @Model.TotalCount @(Model.TotalCount == 1 ? "saved item" : "saved items")
                </span>
                <form asp-action="Clear" method="post" onsubmit="return confirm('Clear all items from your wishlist?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash3"></i> Clear Wishlist
                    </button>
                </form>
            </div>
        }
    </div>

    @if (!Model.IsEmpty)
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
            @foreach (var item in Model.Items)
            {
                <div class="col">
                    <div class="product-card h-100 d-flex flex-column position-relative">
                        <!-- Remove button on corner -->
                        <form asp-action="Remove" method="post" class="position-absolute" style="top: 12px; right: 12px; z-index: 10;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="btn btn-sm btn-light rounded-circle shadow-sm border p-0 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;" title="Remove from wishlist">
                                <i class="bi bi-x-lg text-muted"></i>
                            </button>
                        </form>

                        <!-- Product image wrapper -->
                        <div class="product-img-wrapper">
                            <span class="badge-stock @(item.InStock ? "badge-in-stock" : "badge-out-stock")">
                                @(item.InStock ? "In Stock" : "Out of Stock")
                            </span>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId">
                                <img src="@(item.ProductImageUrl ?? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&auto=format&fit=crop&q=60")" 
                                     alt="@item.ProductName" 
                                     loading="lazy">
                            </a>
                        </div>

                        <!-- Card Body -->
                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <div class="mb-2">
                                <span class="badge-category">@item.CategoryName</span>
                            </div>

                            <h6 class="fw-bold mb-2">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="text-dark text-decoration-none text-truncate d-block">
                                    @item.ProductName
                                </a>
                            </h6>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="product-price fs-5">$@item.Price.ToString("N2")</span>
                                @if (item.InStock)
                                {
                                    <span class="text-muted small">@item.AvailableStock available</span>
                                }
                            </div>

                            <!-- Actions (Move to Cart / View) -->
                            <div class="mt-auto pt-2 d-flex gap-2">
                                @if (item.InStock)
                                {
                                    <form asp-action="MoveToCart" method="post" class="flex-grow-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-sm btn-gradient w-100">
                                            <i class="bi bi-cart-plus"></i> Move to Cart
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-secondary w-100" disabled>Out of Stock</button>
                                }

                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-custom" title="View details">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty Wishlist State -->
        <div class="glass-card text-center py-5 my-5">
            <div class="mx-auto mb-3" style="width: 90px; height: 90px; border-radius: 50%; background: rgba(236, 72, 153, 0.1); display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-heart text-danger display-4"></i>
            </div>
            <h3 class="fw-bold mb-2">Your Wishlist is Empty</h3>
            <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
                You haven't saved any items yet. When browsing products, click the heart icon to save items for later.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Products" asp-action="Index" class="btn btn-gradient btn-lg">
                    <i class="bi bi-bag"></i> Browse Products
                </a>
                <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-custom btn-lg">
                    <i class="bi bi-cart3"></i> View Cart
                </a>
            </div>
        </div>
    }
</div>
