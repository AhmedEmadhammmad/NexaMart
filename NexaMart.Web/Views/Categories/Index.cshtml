@model NexaMart.Web.Models.CategoryListViewModel
@{
    ViewData["Title"] = "Categories Catalog";
    bool isStaff = ViewBag.IsStaff ?? false;
}

<div class="container">
    <!-- Header & Action Row -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill mb-1">Catalog</span>
            <h2 class="fw-bold mb-0">Browse Categories</h2>
            <p class="text-muted small mb-0">Discover products categorized by style, function, and department</p>
        </div>

        @if (isStaff)
        {
            <div>
                <a asp-action="Create" class="btn btn-gradient">
                    <i class="bi bi-folder-plus"></i> Add New Category
                </a>
            </div>
        }
    </div>

    <!-- Search & Filter Bar -->
    <div class="glass-card p-3 mb-4">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <!-- Search by Name (All Users) -->
            <div class="@(isStaff ? "col-md-6" : "col-md-9")">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md);">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control form-control-custom border-start-0" placeholder="Search categories by name or description..." style="border-radius: 0 var(--radius-md) var(--radius-md) 0;">
                </div>
            </div>

            <!-- Search by ID (Staff Only) -->
            @if (isStaff)
            {
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md);">
                            <i class="bi bi-hash text-muted"></i>
                        </span>
                        <input type="number" name="SearchId" value="@Model.Filter.SearchId" class="form-control form-control-custom border-start-0" placeholder="Category ID..." style="border-radius: 0 var(--radius-md) var(--radius-md) 0;">
                    </div>
                </div>
            }

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-gradient w-100">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                @if (!string.IsNullOrEmpty(Model.Filter.SearchTerm) || Model.Filter.SearchId.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-custom" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Categories Grid -->
    @if (Model.Categories.Items.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-4">
            @foreach (var cat in Model.Categories.Items)
            {
                <div class="col">
                    <div class="glass-card h-100 d-flex flex-column p-4 position-relative">
                        <!-- Staff Badges & Actions -->
                        @if (isStaff)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-secondary-subtle text-secondary fw-semibold">ID: #@cat.Id</span>
                                <span class="badge @(cat.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") fw-semibold">
                                    @(cat.IsActive ? "Active" : "Hidden")
                                </span>
                            </div>
                        }

                        <div class="category-icon-wrapper mx-auto mb-3" style="width: 80px; height: 80px;">
                            @if (!string.IsNullOrEmpty(cat.ImageUrl))
                            {
                                <img src="@cat.ImageUrl" alt="@cat.Name" style="width: 100%; height: 100%; object-fit: cover;">
                            }
                            else
                            {
                                <i class="bi bi-tag-fill fs-2 text-primary"></i>
                            }
                        </div>

                        <h5 class="fw-bold text-center mb-2">@cat.Name</h5>
                        <p class="text-muted small text-center mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @(cat.Description ?? "No description available for this category.")
                        </p>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-box-seam me-1 text-primary"></i> @cat.ProductCount Products
                            </span>
                            <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="@cat.Id" class="btn btn-sm btn-soft">
                                Browse <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>

                        @if (isStaff)
                        {
                            <div class="d-flex gap-2 mt-3 pt-2 border-top">
                                <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-custom flex-grow-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@cat.Id" method="post" onsubmit="return confirm('Are you sure you want to delete category \'@cat.Name\'?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Pagination Controls -->
        @if (Model.Categories.TotalPages > 1)
        {
            int currentPage = Model.Categories.PageIndex;
            int totalPages = Model.Categories.TotalPages;
            int totalCount = Model.Categories.TotalCount;
            int pageSize = Model.Categories.PageSize;
            int startItem = ((currentPage - 1) * pageSize) + 1;
            int endItem = Math.Min(currentPage * pageSize, totalCount);

            <div class="pagination-container">
                <div class="pagination-info">
                    Showing <strong>@startItem–@endItem</strong> of <strong>@totalCount</strong> categories • Page <strong>@currentPage</strong> of <strong>@totalPages</strong>
                </div>

                <nav aria-label="Categories pagination">
                    <ul class="pagination-custom">
                        <!-- First Page Button -->
                        <li class="page-item @(Model.Categories.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-PageIndex="1"
                               asp-route-SearchTerm="@Model.Filter.SearchTerm"
                               asp-route-SearchId="@Model.Filter.SearchId"
                               title="First Page">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>

                        <!-- Previous Page Button -->
                        <li class="page-item @(Model.Categories.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-PageIndex="@(currentPage - 1)"
                               asp-route-SearchTerm="@Model.Filter.SearchTerm"
                               asp-route-SearchId="@Model.Filter.SearchId"
                               title="Previous Page">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        <!-- Smart Page Window -->
                        @{
                            int windowSize = 2;
                            int startPage = Math.Max(1, currentPage - windowSize);
                            int endPage = Math.Min(totalPages, currentPage + windowSize);

                            if (startPage > 1)
                            {
                                <li class="page-item @(1 == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-PageIndex="1"
                                       asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                       asp-route-SearchId="@Model.Filter.SearchId">1</a>
                                </li>

                                if (startPage > 2)
                                {
                                    <li class="page-ellipsis">•••</li>
                                }
                            }

                            for (int p = startPage; p <= endPage; p++)
                            {
                                <li class="page-item @(p == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-PageIndex="@p"
                                       asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                       asp-route-SearchId="@Model.Filter.SearchId">@p</a>
                                </li>
                            }

                            if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <li class="page-ellipsis">•••</li>
                                }

                                <li class="page-item @(totalPages == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-PageIndex="@totalPages"
                                       asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                       asp-route-SearchId="@Model.Filter.SearchId">@totalPages</a>
                                </li>
                            }
                        }

                        <!-- Next Page Button -->
                        <li class="page-item @(Model.Categories.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-PageIndex="@(currentPage + 1)"
                               asp-route-SearchTerm="@Model.Filter.SearchTerm"
                               asp-route-SearchId="@Model.Filter.SearchId"
                               title="Next Page">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>

                        <!-- Last Page Button -->
                        <li class="page-item @(Model.Categories.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-PageIndex="@totalPages"
                               asp-route-SearchTerm="@Model.Filter.SearchTerm"
                               asp-route-SearchId="@Model.Filter.SearchId"
                               title="Last Page">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        <div class="glass-card text-center py-5 my-4">
            <i class="bi bi-folder2-open display-3 text-muted"></i>
            <h4 class="fw-bold mt-3">No Categories Found</h4>
            <p class="text-muted">No categories match your search criteria. Try different search terms.</p>
            <a asp-action="Index" class="btn btn-gradient mt-2">View All Categories</a>
        </div>
    }
</div>
