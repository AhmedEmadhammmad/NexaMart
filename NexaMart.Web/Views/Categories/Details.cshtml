@model NexaMart.Web.Models.CategoryCardViewModel
@{
    ViewData["Title"] = Model.Name;
    bool isStaff = ViewBag.IsStaff ?? false;
}

<div class="container">
    <!-- Breadcrumb -->
    <nav class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Categories" asp-action="Index" class="text-decoration-none">Categories</a></li>
            <li class="breadcrumb-item active text-truncate" style="max-width: 250px;">@Model.Name</li>
        </ol>
    </nav>

    <!-- Category Hero Card -->
    <div class="glass-card p-4 p-lg-5 mb-4">
        <div class="row align-items-center g-4">
            <div class="col-md-4 text-center">
                <div class="category-icon-wrapper mx-auto" style="width: 140px; height: 140px; border-radius: var(--radius-xl);">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" style="width: 100%; height: 100%; object-fit: cover;">
                    }
                    else
                    {
                        <i class="bi bi-tag-fill display-3 text-primary"></i>
                    }
                </div>
            </div>

            <div class="col-md-8">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill">Category Department</span>
                    @if (isStaff)
                    {
                        <span class="badge bg-secondary-subtle text-secondary">ID: #@Model.Id</span>
                        <span class="badge @(Model.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                            @(Model.IsActive ? "Active" : "Hidden")
                        </span>
                    }
                </div>

                <h1 class="fw-bold mb-3">@Model.Name</h1>
                <p class="text-muted fs-5 mb-4">
                    @(Model.Description ?? "Browse our extensive selection of high-quality products available under this category.")
                </p>

                <div class="d-flex flex-wrap align-items-center gap-3">
                    <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="@Model.Id" class="btn btn-gradient btn-lg">
                        <i class="bi bi-bag"></i> Browse Products in this Category
                    </a>
                    @if (isStaff)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-custom btn-lg">
                            <i class="bi bi-pencil"></i> Edit Category
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-soft btn-lg">
                        <i class="bi bi-arrow-left"></i> All Categories
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
