@model NexaMart.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="brand-logo-icon mx-auto mb-3" style="width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
                <i class="bi bi-key-fill text-white fs-2"></i>
            </div>
            <h3 class="fw-bold mb-1">Reset Password</h3>
            <p class="text-muted small">Enter your email address and we'll send you a 6-digit recovery code.</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger border-0 rounded-3 small text-center mb-3">
                <i class="bi bi-x-circle me-1"></i> @TempData["ErrorMessage"]
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small"></div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label-custom"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md);">
                        <i class="bi bi-envelope text-muted"></i>
                    </span>
                    <input asp-for="Email" class="form-control form-control-custom border-start-0" placeholder="yourname@domain.com" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;" autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-gradient w-100 py-2 mb-3 fs-6">
                <i class="bi bi-send-fill me-1"></i> Send Recovery Code
            </button>

            <div class="text-center pt-3 border-top">
                <a asp-action="Login" class="text-muted small text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Back to Sign In
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
