@model NexaMart.Web.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Set New Password";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="brand-logo-icon mx-auto mb-3" style="width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                <i class="bi bi-shield-lock-fill text-white fs-2"></i>
            </div>
            <h3 class="fw-bold mb-1">Set New Password</h3>
            <p class="text-muted small">
                Enter the 6-digit recovery code sent to<br />
                <strong class="text-dark">@Model.Email</strong>
            </p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success border-0 rounded-3 small text-center mb-3">
                <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
            </div>
        }

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small"></div>

            <!-- OTP Code -->
            <div class="mb-3 text-center">
                <label asp-for="OtpCode" class="form-label-custom d-block mb-1">6-Digit Recovery Code</label>
                <input asp-for="OtpCode" class="form-control form-control-custom text-center fw-bold fs-4" 
                       placeholder="••••••" maxlength="6" autofocus 
                       style="letter-spacing: 8px; font-family: monospace;" />
                <span asp-validation-for="OtpCode" class="text-danger small d-block mt-1"></span>
            </div>

            <!-- New Password -->
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label-custom"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md);">
                        <i class="bi bi-lock text-muted"></i>
                    </span>
                    <input asp-for="NewPassword" class="form-control form-control-custom border-start-0" placeholder="••••••••" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;" />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                <small class="text-muted d-block mt-1" style="font-size: 11px;">
                    Must contain: 8+ chars, uppercase, lowercase, digit, and symbol (@@$!%*?&#._-)
                </small>
            </div>

            <!-- Confirm Password -->
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label-custom"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md);">
                        <i class="bi bi-lock-fill text-muted"></i>
                    </span>
                    <input asp-for="ConfirmPassword" class="form-control form-control-custom border-start-0" placeholder="••••••••" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-gradient w-100 py-2 mb-3 fs-6">
                <i class="bi bi-check-circle-fill me-1"></i> Update Password &amp; Sign In
            </button>

            <div class="text-center pt-3 border-top">
                <a asp-action="Login" class="text-muted small text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Back to Sign In
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
