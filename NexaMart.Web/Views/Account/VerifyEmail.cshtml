@model NexaMart.Web.Models.VerifyEmailViewModel
@{
    ViewData["Title"] = "Verify Your Email";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="brand-logo-icon mx-auto mb-3" style="width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">
                <i class="bi bi-shield-check text-white fs-2"></i>
            </div>
            <h3 class="fw-bold mb-1">Verify Your Email</h3>
            <p class="text-muted small">
                We sent a 6-digit verification code to<br />
                <strong class="text-dark">@Model.Email</strong>
            </p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success border-0 rounded-3 small text-center mb-3">
                <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning border-0 rounded-3 small text-center mb-3">
                <i class="bi bi-exclamation-triangle me-1"></i> @TempData["WarningMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger border-0 rounded-3 small text-center mb-3">
                <i class="bi bi-x-circle me-1"></i> @TempData["ErrorMessage"]
            </div>
        }

        <form asp-action="VerifyEmail" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small"></div>

            <div class="mb-4 text-center">
                <label asp-for="OtpCode" class="form-label-custom d-block mb-2">Enter 6-Digit Code</label>
                <input asp-for="OtpCode" class="form-control form-control-custom text-center fw-bold fs-3" 
                       placeholder="••••••" maxlength="6" autofocus 
                       style="letter-spacing: 12px; height: 56px; font-family: monospace;" />
                <span asp-validation-for="OtpCode" class="text-danger small d-block mt-2"></span>
                <small class="text-muted d-block mt-1">Code expires in 15 minutes</small>
            </div>

            <button type="submit" class="btn btn-gradient w-100 py-2 mb-3 fs-6">
                <i class="bi bi-check2-circle"></i> Verify &amp; Sign In
            </button>
        </form>

        <!-- Resend Code Form -->
        <div class="text-center pt-3 border-top">
            <p class="text-muted small mb-2">Didn't receive the email?</p>
            <form asp-action="ResendEmailOtp" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@Model.Email" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-repeat"></i> Resend Verification Code
                </button>
            </form>
            <div class="mt-3">
                <a asp-action="Login" class="text-muted small text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Back to Login
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
