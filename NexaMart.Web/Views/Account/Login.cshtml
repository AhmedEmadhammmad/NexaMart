@model NexaMart.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Customer Sign In";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="brand-logo-icon mx-auto mb-3" style="width: 52px; height: 52px; border-radius: 14px;">
                <i class="bi bi-person-fill fs-3"></i>
            </div>
            <h3 class="fw-bold mb-1">Welcome Back</h3>
            <p class="text-muted small">Sign in to your NexaMart customer account</p>
        </div>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small"></div>

            <div class="mb-3">
                <label asp-for="Identifier" class="form-label-custom"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md);">
                        <i class="bi bi-person-badge text-muted"></i>
                    </span>
                    <input asp-for="Identifier" class="form-control form-control-custom border-start-0" placeholder="Email (user@example.com) or Staff ID (e.g. 2)" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;" autofocus />
                </div>
                <span asp-validation-for="Identifier" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <label asp-for="Password" class="form-label-custom"></label>
                    <a href="#" class="text-muted small text-decoration-none">Forgot?</a>
                </div>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md);">
                        <i class="bi bi-lock text-muted"></i>
                    </span>
                    <input asp-for="Password" class="form-control form-control-custom border-start-0" placeholder="••••••••" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                <label asp-for="RememberMe" class="form-check-label text-muted small" for="rememberMeCheck">Keep me signed in for 48 hours</label>
            </div>

            <button type="submit" class="btn btn-gradient w-100 py-2 mb-3 fs-6">
                <i class="bi bi-box-arrow-in-right"></i> Sign In to Account
            </button>

            <!-- Link to Register -->
            <div class="text-center pt-3 border-top">
                <p class="text-muted small mb-0">
                    Don't have an account yet? 
                    <a asp-action="Register" class="text-primary fw-semibold text-decoration-none">Join Free</a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
